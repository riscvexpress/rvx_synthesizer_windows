<?xml version="1.0" ?>
<rvx>
  <dec_ip>
    <name>ethernet_mac_lite</name>
    <hdl_name>ERVP_ETHERNET_MAC_LITE</hdl_name>
    <def_parameter>
      <name>BW_ADDR</name>
      <value>32</value>
    </def_parameter>
    <def_parameter>
      <name>BW_DATA</name>
      <value>32</value>
    </def_parameter>
    <def_parameter>
      <name>MDC_DIVIDER</name>
      <value>40</value>
    </def_parameter>
    <def_parameter>
      <name>SIZE_OF_MEMORYMAP</name>
      <value>0x2000</value>
    </def_parameter>

    <imp_dependent/>

    <signal>
      <name>clk_axi</name>
      <width>1</width>
      <port>input</port>
      <comm_type>clk_system</comm_type>
    </signal>

    <signal>
      <name>rstnn_axi</name>
      <width>1</width>
      <port>input</port>
    </signal>

    <reset_property>
      <id>rstnn_axi</id>
      <type>asynch</type>
      <type>negative</type>
      <group>3</group>
    </reset_property>

    <core>
      <sync>clk_axi</sync>
      <init>rstnn_axi</init>
    </core>

    <signal>
      <name>clk_phy_ref</name>
      <width>1</width>
      <port>input</port>
      <comm_type>clk_eth_phy_ref</comm_type>
    </signal>

    <signal>
      <name>interrupt</name>
      <width>1</width>
      <port>output</port>
      <user_available/>
    </signal>

    <interface>
      <name>slave</name>
      <library_name>axi</library_name>
      <hdl_prefix></hdl_prefix>
      <role>receiver</role>
      <comm_type>memory:all</comm_type>
      <memorymap>
        <size>SIZE_OF_MEMORYMAP</size>
      </memorymap>
      <parameter>
        <id>bw_addr</id>
        <value>BW_ADDR</value>
      </parameter>
      <parameter>
        <id>bw_data</id>
        <value>BW_DATA</value>
      </parameter>
      <parameter>
        <id>bw_tid</id>
        <value>4</value>
      </parameter>
      <sync>clk_axi</sync>
      <init>rstnn_axi</init>
    </interface>

    <included_port>ethernet_phy_inferface</included_port>

  </dec_ip>
</rvx>
