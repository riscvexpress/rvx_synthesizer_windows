			</signal>
			<signal>
				<name>source</name>
				<width>bw_source</width>
				<port>output</port>
			</signal>
			<signal>
				<name>address</name>
				<width>bw_addr</width>
				<port>output</port>
			</signal>
			<signal>
				<name>mask</name>
				<width>bw_data/8</width>
				<port>output</port>
			</signal>
			<signal>
				<name>data</name>
				<width>bw_data</width>
				<port>output</port>
