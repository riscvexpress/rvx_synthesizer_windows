			<signal>
				<name>data</name>
				<width>bw_data</width>
				<port>input</port>
			</signal>
			<signal>
				<name>error</name>
				<width>1</width>
				<port>input</port>
			</signal>
			<signal>
				<name>user</name>
				<width>bw_d_user</width>
				<port>input</port>
			</signal>
