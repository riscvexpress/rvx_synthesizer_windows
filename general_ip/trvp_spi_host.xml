<?xml version="1.0" ?>
<rvx>
  <dec_ip>
    <name>trvp_spi_host</name>
    <hdl_name>TRVP_SPI_HOST</hdl_name>
    <def_parameter>
      <name>BW_ADDR</name>
      <value>32</value>
    </def_parameter>
    <def_parameter>
      <name>BW_DATA</name>
      <value>32</value>
    </def_parameter>
    <def_parameter>
      <name>BW_TLUL_SIZE</name>
      <value>2</value>
    </def_parameter>
    <def_parameter>
      <name>BW_TLUL_SOURCE</name>
      <value>8</value>
    </def_parameter>
    <def_parameter>
      <name>BW_TLUL_SINK</name>
      <value>1</value>
    </def_parameter>
    <def_parameter>
      <name>NUM_DEVICE</name>
      <value>1</value>
    </def_parameter>

    <signal>
      <name>clk</name>
      <width>1</width>
      <port>input</port>
      <comm_type>gclk_system_external</comm_type>
    </signal>

    <signal>
      <name>rstnn</name>
      <width>1</width>
      <port>input</port>
    </signal>

    <reset_property>
      <id>rstnn</id>
      <type>asynch</type>
      <type>negative</type>
      <group>3</group>
    </reset_property>

    <interface>
      <name>qspi_host</name>
      <library_name>qspi</library_name>
      <role>sender</role>
      <comm_type>external</comm_type>
			<parameter>
				<id>num_device</id>
				<value>NUM_DEVICE</value>
			</parameter>
      <sync>None</sync>
      <init>None</init>
    </interface>

    <signal>
      <name>intr_error</name>
      <width>1</width>
      <port>output</port>
      <user_available/>
    </signal>

    <signal>
      <name>intr_spi_event</name>
      <width>1</width>
      <port>output</port>
      <user_available/>
    </signal>

    <core>
      <sync>clk</sync>
      <init>rstnn</init>
    </core>

    <interface>
      <name>slave</name>
      <library_name>tlot</library_name>
      <hdl_prefix></hdl_prefix>
      <role>receiver</role>
      <comm_type>memory:all</comm_type>
      <memorymap>
        <size>0x1000</size>
      </memorymap>
      <parameter>
        <id>bw_addr</id>
        <value>BW_ADDR</value>
      </parameter>
      <parameter>
        <id>bw_data</id>
        <value>BW_DATA</value>
      </parameter>
      <parameter>
        <id>bw_size</id>
        <value>BW_TLUL_SIZE</value>
      </parameter>
      <parameter>
        <id>bw_source</id>
        <value>BW_TLUL_SOURCE</value>
      </parameter>
      <parameter>
        <id>bw_sink</id>
        <value>BW_TLUL_SINK</value>
      </parameter>
      <sync>clk</sync>
      <init>rstnn</init>
    </interface>
  </dec_ip>
</rvx>
